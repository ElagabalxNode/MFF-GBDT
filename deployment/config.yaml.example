# --- Global MLflow Settings ---
mlflow:
  # MLflow server address. If running locally without server, use "file:./training_workspace/mlruns"
  tracking_uri: "http://localhost:5000" 
  # Folder inside deployment where models will be downloaded. Don't remove it from .gitignore!
  cache_dir: "models_cache"

# --- Hardware & Camera ---
camera:
  provider: "orbbec"        # or "mock" for video testing
  device_index: 0
  width: 640  # Changed from 1280 to 640 for better compatibility
  height: 480 # Changed from 720 to 480
  fps: 30
  align_mode: "HW_MODE"     # Hardware synchronization of RGB and Depth

# --- Stage 1: Segmentation (YOLO) ---
segmentation:
  # Model settings
  model:
    source: "mlflow" # or "local"
    # Run ID from MFF_Benchmark_YOLOv8 or Training experiment
    mlflow_run_id: "REPLACE_WITH_YOLO_RUN_ID" 
    # Path to file within MLflow artifacts (usually weights/best.pt)
    artifact_path: "weights/best.pt"
  
  # Inference parameters
  img_size: 640
  conf_threshold: 0.85
  device: "cuda" # cuda, cpu, mps

# --- Stage 2: Tracking ---
tracker:
  type: "botsort" # Built-in YOLO tracker (BoT-SORT or ByteTrack)
  filters:
    min_solidity: 0.90 # Filter for "spread wings"

# --- Stage 3: Feature Extraction ---
features:
  manual:
    # Scaler trained on training data (from prepare_fusion_split.py)
    scaler:
      source: "mlflow" # or "local"
      # For local: path relative to deployment/ or absolute path
      local_path: "data/models/pca/auto_scaler.pkl"
      # For mlflow:
      mlflow_run_id: "REPLACE_WITH_SCALER_RUN_ID"
      artifact_path: "feature_scaler.pkl"
  
  auto:
    # FusionNet weights (from train_fusion_mlflow.py)
    weights:
      source: "mlflow" # or "registry" or "local"
      # For registry: use model_name and version/stage
      model_name: "FusionNet"  # Name in Model Registry
      version: null  # Specific version number (optional)
      stage: "Production"  # Stage: Production, Staging, Archived (optional, takes precedence over version)
      # For mlflow: use run_id and artifact_path
      mlflow_run_id: "REPLACE_WITH_FUSION_RUN_ID"
      artifact_path: "best_model.pth"  # Usually saved as 'best_model.pth' via log_artifact
      # For local: path relative to deployment/ or absolute path
      local_path: null
    arch: "fusionnet50"

  pca:
    enabled: true
    # PCA transformer (from train_lightgbm_pca.py)
    model:
      source: "mlflow"
      mlflow_run_id: "REPLACE_WITH_PCA_RUN_ID"
      artifact_path: "models/auto_pca.pkl"
    # Scaler for PCA (important! separate from manual scaler)
    scaler:
      source: "mlflow"
      mlflow_run_id: "REPLACE_WITH_PCA_RUN_ID"
      artifact_path: "models/auto_scaler.pkl"

# --- Stage 4: Weight Prediction (GBDT) ---
gbdt:
  # LightGBM model
  model:
    source: "mlflow" # or "registry" or "local"
    # For registry: use model_name and version/stage
    model_name: "BroilerWeightModel"  # Name in Model Registry
    version: null  # Specific version number (optional)
    stage: "Production"  # Stage: Production, Staging, Archived (optional, takes precedence over version)
    # For mlflow: use run_id and model_uri
    mlflow_run_id: "REPLACE_WITH_LGBM_RUN_ID"
    model_uri: "model"  # URI within run (usually just "model")
    load_method: "mlflow"  # mlflow/lightgbm/sklearn (object loading) or file (path)
    # For local: path relative to deployment/ or absolute path
    local_path: null

# --- Database ---
database:
  path: "data/inference_prod.db"